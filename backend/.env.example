# Copy this file to .env and fill in your values. Never commit .env.

NODE_ENV=development
PORT=3000

# MongoDB: local, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/ceragem-physio

# Websites allowed to call this API (comma separated, no trailing slash).
# Use your real domain in production, e.g. https://www.yourdomain.com
CORS_ORIGINS=http://localhost:8000,http://localhost:5000,http://localhost:3000

# Serve the website files from this server too (true/false).
# Set false when the frontend is hosted somewhere else (Netlify, Vercel).
SERVE_FRONTEND=true

# Clinic opening hours (24h clock). Mon to Sat. Sunday is closed.
OPEN_HOUR=8
CLOSE_HOUR=17
# How many clients can book the same hour
MAX_PER_SLOT=2

# Rate limits
BOOKING_RATE_LIMIT=5

# Email notifications (optional). Pick ONE way to send:
#
# A) Resend (recommended, works on Render's free plan). Free account at resend.com.
#    Until you verify your own domain, Resend only delivers to the email address
#    you signed up with, so set NOTIFY_EMAIL to that same address.
RESEND_API_KEY=
EMAIL_FROM="Ceragem Physio <onboarding@resend.dev>"
#
# B) SMTP (works on your computer or a paid host; Render's free plan blocks it).
#    Leave SMTP_HOST empty to switch it off.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, use an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ceragem Physio <ceragemphysio@gmail.com>"
# Where new booking and contact alerts are sent
NOTIFY_EMAIL=ceragemphysio@gmail.com
